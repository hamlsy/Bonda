# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Backend
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/bonda
DB_USERNAME=bonda
DB_PASSWORD=replace-with-a-local-password
CORS_ALLOWED_ORIGIN=http://localhost:5173

# DART OpenAPI (keep collection disabled until a valid key and issuer corpCode are configured)
DART_API_KEY=
DART_COLLECTION_ENABLED=false
DART_COLLECTION_CRON=0 0 6 * * *
DART_LOOKBACK_DAYS=7

# AI extraction (disabled uses the local fake extractor and never calls an external API)
BONDA_AI_ENABLED=false
OPENAI_API_KEY=
BONDA_AI_MODEL=gpt-5.6-luna
